# Copy to .env (Docker) or .env.local (npm run dev) and fill in the values.

# --- required ---
NEXTAUTH_URL=http://algosim.lan:3000      # the address students type, e.g. the server's LAN IP
NEXTAUTH_SECRET=                          # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_EMAILS=                             # comma-separated; these accounts see /admin

# --- Docker only: database credentials (the app's MONGODB_URI is built from these) ---
MONGO_ROOT_USER=algosim
MONGO_ROOT_PASSWORD=
# APP_PORT=3000

# --- npm run dev only ---
# MONGODB_URI=mongodb://localhost:27017/algo-sim

# --- sign-in methods ---
# Local institution accounts work without internet; create them with scripts/create-users.mjs.
LOCAL_AUTH=true
# Google OAuth (needs internet):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# E-mailed sign-in links (needs an SMTP server reachable from the app):
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=
